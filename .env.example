# ── Obrigatórias ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:senha@localhost:5432/igreja_db"
# 32+ caracteres aleatórios (em produção o servidor se recusa a subir com segredo fraco):
#   openssl rand -hex 48
JWT_SECRET="troque-por-uma-chave-secreta-longa-e-aleatoria"

# ── Opcionais ────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN="12h"
PORT=3333
NODE_ENV="development"

# Produção — origens liberadas no CORS, separadas por vírgula (não precisa se a API serve o frontend):
# CORS_ORIGINS="https://app.suaigreja.org"
# Nº de proxies na frente do servidor (Render/Railway/Nginx = 1). Necessário p/ limitar tentativas por IP real:
# TRUST_PROXY=1
# Desligue o job diário de alertas em réplicas extras:
# ENABLE_CRON=true
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASS= / SMTP_FROM=
# WHATSAPP_API_URL= / WHATSAPP_API_TOKEN=
