{
  "name": "igreja-backend",
  "version": "1.1.0",
  "description": "Sistema de Gestão - Assembleia de Deus Jardim Cidade Universitária",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:demo": "ts-node prisma/seed-demo.ts",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:seed:admin": "ts-node prisma/seed-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/recorrencia.test.ts && tsx tests/aniversario.test.ts && tsx tests/eventos.test.ts && tsx tests/api.test.ts && tsx tests/producao.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
